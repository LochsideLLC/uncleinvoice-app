generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["uncleinvoice"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  backupEmail  String?
  passwordHash String?
  logoUrl              String?
  businessLogoUrl      String?
  businessWordmarkUrl  String?
  businessLogoKind     String   @default("mark")
  businessName         String?
  businessEmail        String?
  phone        String?
  addressLine  String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  taxId        String?
  clientTerm   String   @default("clients")
  admin        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       WorkspaceMember[]
  sessions          Session[]
  seededInvoices    Invoice[]         @relation("SeededBy")
  createdWorkspaces Workspace[]       @relation("CreatedBy")

  @@schema("uncleinvoice")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@schema("uncleinvoice")
}

model Workspace {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  addressLine       String?
  city              String?
  region            String?
  postalCode        String?
  taxId             String?
  invoicePrefix     String   @default("INV")
  nextInvoiceNumber Int      @default(1)
  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members     WorkspaceMember[]
  contractors Contractor[]
  invoices    Invoice[]

  @@schema("uncleinvoice")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@schema("uncleinvoice")
}

model Contractor {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String?
  addressLine  String?
  city         String?
  region       String?
  postalCode   String?
  taxId        String?
  userId       String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoices Invoice[]

  @@schema("uncleinvoice")
}

model Invoice {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contractorId     String
  contractor       Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  number           String
  status           String
  issueDate        DateTime
  dueDate          DateTime?
  poNumber         String?
  paymentTerms     String?
  paymentInstructions String?
  taxRateBps       Int       @default(0)
  amountPaid       Int       @default(0)
  fromTaxId        String?
  billToTaxId      String?
  fromContactName  String?
  billToContactName String?
  fromAddressLine  String?
  fromCity         String?
  fromRegion       String?
  fromPostalCode   String?
  serviceStart     DateTime?
  serviceEnd       DateTime?
  notes            String?
  internalNote     String?
  seededByUserId   String?
  seededBy         User?     @relation("SeededBy", fields: [seededByUserId], references: [id])
  confirmedAt      DateTime?
  confirmedByEmail String?
  sentAt           DateTime?
  sentToEmail      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lineItems   InvoiceLineItem[]
  events      InvoiceEvent[]
  tokens      MagicLink[]
  attachments InvoiceAttachment[]

  @@unique([workspaceId, number])
  @@schema("uncleinvoice")
}

/// A supporting document that corroborates the invoice -- typically the payer's
/// own accounting record for these payments, so the contractor can check the
/// invoice against the books it was seeded from before confirming it.
model InvoiceAttachment {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind             String   @default("source_record")
  label            String?
  filename         String
  contentType      String
  byteSize         Int
  data             Bytes
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([invoiceId])
  @@schema("uncleinvoice")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Int
  taxable     Boolean @default(false)
  sortOrder   Int     @default(0)

  @@schema("uncleinvoice")
}

model InvoiceEvent {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type       String
  actorEmail String?
  actorName  String?
  message    String
  createdAt  DateTime @default(now())

  @@schema("uncleinvoice")
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  purpose   String
  email     String
  userId    String?
  invoiceId String?
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@schema("uncleinvoice")
}

model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  bodyText  String
  bodyHtml  String?
  link      String?
  createdAt DateTime @default(now())

  @@schema("uncleinvoice")
}

model Sponsor {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  about     String?
  url       String
  email     String?
  phone     String?
  city      String?
  logoUrl   String?
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("uncleinvoice")
}
