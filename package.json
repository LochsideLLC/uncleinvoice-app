{
  "name": "uncleinvoice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:upgrades": "node scripts/test-upgrades.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:phone": "node scripts/test-phone.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "stack": "docker compose up --build",
    "datastore:test": "node scripts/datastore.mjs test",
    "datastore:deploy": "node scripts/datastore.mjs deploy",
    "datastore:seed": "node scripts/datastore.mjs seed",
    "datastore:env": "node scripts/datastore.mjs env",
    "dns:netlify": "node scripts/cloudflare-netlify-dns.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.3.8",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
