# Local Docker
DATABASE_URL="postgresql://uncle:uncle@localhost:5433/uncleinvoice"
DIRECT_URL="postgresql://uncle:uncle@localhost:5433/uncleinvoice"

# Lochside datastore (https://supabase.com/dashboard/project/pvolllgvujjvteijtnid)
# Put the database password here. Never commit this file. Never paste it in chat.
# Then run: npm run datastore:deploy
DATASTORE_DB_PASSWORD=

# Cloudflare: Zone.DNS Edit + Zone.Zone Read for uncleinvoice.com
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string"
RESEND_API_KEY=
MAIL_FROM="Uncle Invoice <noreply@uncleinvoice.com>"
OUTBOUND_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_COST_CAP_CONFIRMED=false
EMAIL_GLOBAL_DAILY_LIMIT=80
EMAIL_GLOBAL_MONTHLY_LIMIT=2400
EMAIL_RECIPIENT_DAILY_LIMIT=10

# Google OAuth (Web client). Redirect URIs:
# http://localhost:3000/api/auth/google/callback
# https://uncleinvoice.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout (test mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
INVOICE_VIEW_TRACKING_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
INVOICE_GLOBAL_DAILY_LIMIT=500
INVOICE_PER_USER_DAILY_LIMIT=50
CHECKOUT_GLOBAL_DAILY_LIMIT=1000
CHECKOUT_PER_USER_DAILY_LIMIT=20
VIEW_EVENTS_GLOBAL_DAILY_LIMIT=1000
VIEW_EVENTS_PER_INVOICE_DAILY_LIMIT=50
PDF_GLOBAL_DAILY_LIMIT=2000
PDF_PER_INVOICE_DAILY_LIMIT=50
PDF_PER_USER_DAILY_LIMIT=200
PUSH_GLOBAL_DAILY_LIMIT=500
PUSH_PER_USER_DAILY_LIMIT=30
