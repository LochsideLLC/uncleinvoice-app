# Local Docker
DATABASE_URL="postgresql://uncle:uncle@localhost:5433/uncleinvoice"
DIRECT_URL="postgresql://uncle:uncle@localhost:5433/uncleinvoice"

# Lochside datastore (https://supabase.com/dashboard/project/pvolllgvujjvteijtnid)
# Put the database password here. Never commit this file. Never paste it in chat.
# Then run: npm run datastore:deploy
DATASTORE_DB_PASSWORD=

# Cloudflare: Zone.DNS Edit + Zone.Zone Read for uncleinvoice.com
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string"
RESEND_API_KEY=
MAIL_FROM="Uncle Invoice <noreply@uncleinvoice.com>"

# Google OAuth (Web client). Redirect URIs:
# http://localhost:3000/api/auth/google/callback
# https://uncleinvoice.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout (test mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
